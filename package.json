{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "flock",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "biome check .",
    "check:write": "biome check . --write",
    "lint": "biome lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "latest",
    "turbo": "^2.11.10"
  }
}
